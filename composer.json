{
  "name": "aminulbd/laravel-packages",
  "description": "Packages for Laravel",
  "type": "library",
  "license": "MIT",
  "keywords": ["packages", "laravel"],
  "support": {
    "issues": "https://github.com/AminulBD/laravel-packages/issues",
    "source": "https://github.com/AminulBD/laravel-packages"
  },
  "autoload": {
    "psr-4": {
      "AminulBD\\Package\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AminulBD\\Package\\Laravel\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Aminul Islam",
      "email": "me@aminul.net"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.0",
    "laravel/framework": ">=9.0"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "AminulBD\\Package\\Laravel\\PackageServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  }
}
